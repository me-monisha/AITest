# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database
# Quick start (zero setup): sqlite:///./deviations.db
# Postgres (recommended, matches assignment spec, use docker-compose): postgresql+psycopg2://aivoa:aivoa@localhost:5432/aivoa_deviations
# MySQL: mysql+pymysql://aivoa:aivoa@localhost:3306/aivoa_deviations
DATABASE_URL=sqlite:///./deviations.db

# CORS - the Vite dev server origin
FRONTEND_ORIGIN=http://localhost:5173
